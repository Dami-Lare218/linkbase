# Copy this file to .env.local and fill in real values there.
# Never put real credentials in this file: it is committed.

# MongoDB Atlas connection string for development (server-only, never NEXT_PUBLIC_).
# Use a dev-only database user with readWrite on `linkbase` only (e.g. linkbase_dev).
# Keep `w=majority` complete: an empty `w=` makes every connection fail.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/linkbase?retryWrites=true&w=majority

# Separate test database used by QA. Put it in .env.test (Git-ignored), not .env.local.
# Only `npm run qa:server` and `npm run qa:cleanup` read it. They refuse to run unless the
# database name ends in "_test" and differs from MONGODB_URI.
# Use its own database user with readWrite on `linkbase_test` only (e.g. linkbase_qa), never the dev user.
MONGODB_URI_TEST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/linkbase_test?retryWrites=true&w=majority

# Auth.js secret: signs and encrypts session cookies (server-only, never NEXT_PUBLIC_).
# Generate one with `npx auth secret` or `openssl rand -base64 33`. Use a different value per environment.
AUTH_SECRET=<random-32-byte-base64-string>

# Only when self-hosting behind a reverse proxy (not needed on Vercel):
# AUTH_TRUST_HOST=true

# Vercel Blob read-write token for profile pictures (server-only, never NEXT_PUBLIC_).
# Create a Blob store at vercel.com -> Storage -> Blob and copy its token into .env.local.
# Use a dev-only store (public access), not the production store. Vercel's BLOB_STORE_ID and
# BLOB_WEBHOOK_PUBLIC_KEY aren't used: the app always passes this token explicitly.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_<store>_<secret>

# QA only: token of a SEPARATE Blob store, in .env.test (Git-ignored). `npm run qa:server` passes it
# to the app as BLOB_READ_WRITE_TOKEN; `npm run qa:cleanup` uses it to delete QA users' pictures.
# Both refuse if it's missing or equal to BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN_TEST=vercel_blob_rw_<test-store>_<secret>
