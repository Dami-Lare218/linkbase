# Copy this file to .env.local and fill in real values there.
# Never put real credentials in this file: it is committed.

# MongoDB Atlas connection string for development (server-only, never NEXT_PUBLIC_).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/linkbase?retryWrites=true&w=majority

# Separate test database used by QA. Lives in .env.test, never the dev or production database.
MONGODB_URI_TEST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/linkbase_test?retryWrites=true&w=majority

# Auth.js secret: signs and encrypts session cookies (server-only, never NEXT_PUBLIC_).
# Generate one with `npx auth secret` or `openssl rand -base64 33`. Use a different value per environment.
AUTH_SECRET=<random-32-byte-base64-string>

# Only when self-hosting behind a reverse proxy (not needed on Vercel):
# AUTH_TRUST_HOST=true
